MODEL=your-model
API_KEY=api-key-provider
BASE_URL=https://openrouter.ai/api/v1 #Openrouter example

# Agente Planejador (Planning Agent) -- opcional. Se não definidas, o agente
# reaproveita as variáveis MODEL/API_KEY/BASE_URL acima. Definir estas
# permite usar um provedor/modelo diferente (ex.: mais barato) só para o
# estágio de planejamento. Preços em USD por 1 milhão de tokens.
PLANNER__API_KEY=api-key-provider
PLANNER__BASE_URL=https://openrouter.ai/api/v1
PLANNER__MODEL_NAME=your-planner-model
PLANNER__INPUT_PRICE=0.0
PLANNER__OUTPUT_PRICE=0.0